# ─────────────────────────────────────────────
#  ATS Checker — Root .gitignore
#  Covers: frontend/ (Vite/React), admin/ (Vite/React), backend/ (Node/Express)
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment / Secrets ─────────────────────
.env
.env.*
!.env.example
*.local

# ── Build outputs ─────────────────────────────
dist/
dist-ssr/
build/
out/
.output/

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Vite / React ──────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── OS files ──────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor & IDE ──────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
*.tgz
*.zip
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
